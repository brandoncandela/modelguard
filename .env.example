# Copy to .env and fill in. .env is gitignored. Never commit real secrets.

# development, test or production. Production refuses to start without a secret key.
MODELGUARD_ENV=development

# Signing key for access tokens, at least 32 characters. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
MODELGUARD_SECRET_KEY=

# Password given to every synthetic demo user when the database is seeded. Choose any value.
# If left empty, the seed command generates a random one and prints it once.
MODELGUARD_DEMO_PASSWORD=

# Used by docker-compose for the PostgreSQL container. Choose any strong value.
POSTGRES_PASSWORD=

# SQLite is the default for local development. For PostgreSQL:
#   MODELGUARD_DATABASE_URL=postgresql://modelguard:<password>@localhost:5432/modelguard
# MODELGUARD_DATABASE_URL=

MODELGUARD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MODELGUARD_ACCESS_TOKEN_MINUTES=60

# Synthetic data. The same seed and anchor date always produce the same data.
MODELGUARD_SEED=20261031
# Last day of the latest complete month of synthetic history (defaults to the end of last month)
# MODELGUARD_ANCHOR_DATE=2026-10-31
# Drift in the seeded history: none, moderate or severe, applied over the last N periods
MODELGUARD_DRIFT_SCENARIO=moderate
MODELGUARD_DRIFT_PERIODS=3
# Business date for overdue calculations (defaults to today)
# MODELGUARD_AS_OF_DATE=2026-11-25
